# Template for local development: copy to .env.local and adjust.
# Every NEXT_PUBLIC_ variable is built into the browser bundle, so never put
# secrets here. Real values for deploys are set in Netlify's environment
# variables. Validated at build time by src/env.ts.

# Required. Canonical site origin (no trailing slash). Used for canonical
# URLs, Open Graph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://hunterx.co.in

# Required. Backend API base URL, INCLUDING the /api prefix (the backend
# mounts every route under /api). Used by the account-deletion and
# reset-password pages. Point local development at the UAT API.
NEXT_PUBLIC_API_URL=https://api.hunterx.co.in/api

# Optional. Store listing URLs for the download buttons. Leave commented out
# to use the built-in placeholders; set to an empty value to show
# "Coming soon" instead of the button.
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXXX
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=PACKAGE_NAME
